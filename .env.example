# OPENROUTER_API_KEY: Required for OpenRouter AI chat & multimodal inference (nvidia/nemotron-3.5-super-vl:free).
# Automatically injected at runtime from environment secrets.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GEMINI_API_KEY: Optional server-side key for Google Search grounding (gemini-4-hydrogen).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Optional neural voice synthesis & Scribe STT.
# Never hardcode keys in source files; leave unset to use browser Web Speech fallback.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# MEDHAVI_SESSION_SECRET: Server-only HMAC-SHA256 secret used to seal verified identities.
MEDHAVI_SESSION_SECRET="REPLACE_WITH_RANDOM_256_BIT_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
